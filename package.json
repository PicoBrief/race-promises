{
  "name": "@pico-brief/race-promises",
  "version": "1.0.1",
  "description": "A utility that runs async tasks in parallel and returns the first one that succeeds — automatically retrying if something goes wrong.",
  "type": "module",
  "main": "./dist/racePromises.js",
  "types": "./dist/racePromises.d.ts",
  "exports": {
    ".": {
      "import": "./dist/racePromises.js",
      "types": "./dist/racePromises.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "node --test racePromises.test.ts",
    "prepublishOnly": "npm run build"
  },
    "repository": {
        "type": "git",
        "url": "https://github.com/PicoBrief/race-promises"
    },
    "keywords": [
    "retry",
    "race",
    "promises",
    "async",
    "llm"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.2.3",
    "typescript": "^5.0.0"
  }
}
